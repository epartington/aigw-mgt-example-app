# Copy to .env and fill in real values. Never commit .env.
# In a real deployment, inject these the same way from a vault or secret
# manager — the app only reads environment variable names, not a file path.

# OIDC login (Authorization Code flow). The app discovers the authorize,
# token, and JWKS endpoints from OIDC_ISSUER_URL on its own.
OIDC_ISSUER_URL=https://your-idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# Signs the session cookie. Use a long, random value.
SESSION_SECRET=

# AI Gateway admin APIs (analytics, policies, and similar). Client-credentials
# grant, not a user's own key. AIGW_TOKEN_URL is a separate auth server, not
# the gateway itself — ask your admin team for it.
AIGW_BASE_URL=https://api.apps.paloaltonetworks.com/ai_gw/v2
AIGW_TOKEN_URL=
AIGW_CLIENT_ID=
AIGW_CLIENT_SECRET=

# Gateway calls scoped to one user forward that user's own ID token as the
# Bearer value instead — no separate config value needed for that.
